# Admin login
ADMIN_EMAIL=admin@temple.local
ADMIN_PASSWORD=Temple@123
# Long random string used to sign the admin session cookie
AUTH_SECRET=change-this-to-a-long-random-string-at-least-32-chars
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay (Dashboard > Account & Settings > API Keys). Start with TEST keys (rzp_test_...), switch to LIVE keys when ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed for the webhook backup (Dashboard > Settings > Webhooks > set a secret)
RAZORPAY_WEBHOOK_SECRET=
